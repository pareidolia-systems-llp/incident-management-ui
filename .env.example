VITE_API_BASE_URL=http://localhost:8080
# Enable only with the matching HR-capable backend and verified schema.
VITE_ROUTINE_HR_ISSUES_ENABLED=false
# F1 UI gates. The backend still requires verified identity and operation-specific permissions.
VITE_EMPLOYEE_MANAGEMENT_ENABLED=false
VITE_DEPARTMENT_ADMIN_ENABLED=false
# F2/F3 UI opt-ins. Guarded backend endpoints and operation-specific authorization are still required.
VITE_INCIDENT_ASSIGNMENT_ENABLED=false
VITE_INCIDENT_SECURITY_ADMIN_ENABLED=false

# Membership panel also requires Department Administration and server authorization.
VITE_DEPARTMENT_MEMBERSHIP_ADMIN_ENABLED=false
